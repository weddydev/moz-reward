# Moz Rewards (infra/host/harden.sh): ban SSH brute force. Reads the journal (backend systemd), so it works
# without /var/log/auth.log. Repeat offenders get longer bans.
[DEFAULT]
backend = systemd
bantime = 1h
findtime = 10m
maxretry = 3
bantime.increment = true
bantime.maxtime = 1w

[sshd]
enabled = true
mode = aggressive
port = ssh
