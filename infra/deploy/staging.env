# Staging non-secret settings (P0-15). Committed: no secret ever goes here (scripts/deploy-env.test.ts checks).
# Secrets are GitHub secrets named <KEY>_STAGING; scripts/deploy-env.mjs combines both per role.
APP_URL=https://staging.mozrewards.com
APP_HOST=staging.mozrewards.com
REDIS_KEY_PREFIX=stg:
TRUSTED_PROXY=cloudflare
EMAIL_PROVIDER=resend
EMAIL_FALLBACK_PROVIDER=brevo
EMAIL_FROM=Moz Rewards <hello@mail.mozrewards.com>
DATA_ENCRYPTION_KEY_ID=k1
LOG_LEVEL=info
BASIC_AUTH_USER=moz
