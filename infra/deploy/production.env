# Production non-secret settings (P0-15). Committed: no secret ever goes here (scripts/deploy-env.test.ts checks).
# Secrets are GitHub secrets named <KEY>_PRODUCTION; scripts/deploy-env.mjs combines both per role.
# Production goes live in P5 (launch): until then the app host serves the maintenance page (MAINTENANCE=on).
# UMAMI_HOST is the analytics dashboard host behind Cloudflare Access.
APP_URL=https://mozrewards.com
APP_HOST=mozrewards.com
UMAMI_HOST=stats.mozrewards.com
MAINTENANCE=on
REDIS_KEY_PREFIX=prod:
TRUSTED_PROXY=cloudflare
EMAIL_PROVIDER=resend
EMAIL_FALLBACK_PROVIDER=brevo
EMAIL_FROM=Moz Rewards <hello@mail.mozrewards.com>
DATA_ENCRYPTION_KEY_ID=k1
LOG_LEVEL=info
