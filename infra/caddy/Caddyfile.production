# Production Caddy (P0-15): <domain> and the Umami dashboard host through the production Tunnel only. Until
# launch (P5) the app host serves the maintenance page (MAINTENANCE=on). Env (root-only caddy.env, written by
# `moz-deploy`): APP_HOST, UMAMI_HOST, MAINTENANCE (on|off).
{
	admin off
	auto_https off
	persist_config off
	servers {
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-Ip
		timeouts {
			read_header 10s
			idle 2m
		}
	}
	log default {
		output stderr
		format json
		level WARN
	}
}

# C-36: exact paths only, no cookies or credentials either way.
(umami_routes) {
	handle /u/script.js {
		rewrite * /script.js
		reverse_proxy umami:3000 {
			header_up -Cookie
			header_up -Authorization
			header_down -Set-Cookie
		}
	}
	handle /u/api/send {
		rewrite * /api/send
		reverse_proxy umami:3000 {
			header_up -Cookie
			header_up -Authorization
			header_down -Set-Cookie
		}
	}
}

import common.caddy

http://{$APP_HOST} {
	@maintenance expression `{env.MAINTENANCE} == "on"`
	handle @maintenance {
		header -Server
		header Retry-After 3600
		header Cache-Control "no-store"
		root * /srv/maintenance
		rewrite * /index.html
		file_server {
			status 503
		}
	}
	import app_common
}

# Umami dashboard and login: its own host, behind Cloudflare Access (HUMAN_TASKS), never on the app origin.
http://{$UMAMI_HOST} {
	import access_log
	header -Server
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy umami:3000
}

http:// {
	respond 404
}
