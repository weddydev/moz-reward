# Moz Rewards — environment variables. Never commit real values.
# Only NEXT_PUBLIC_* variables reach the browser bundle; everything else is server-only.
# Local: `pnpm setup:env` creates .env.local from this file with generated secrets (README "Local setup").
# Validated at startup (src/server/env.ts, src/lib/env.ts): a missing/invalid variable stops the app and the
# error names it. Values below are safe local defaults for the Docker services in infra/docker-compose.dev.yml.
# NODE_ENV is not set here: Next.js sets it (development for `pnpm dev`, production for build/start).

# App
APP_URL=http://localhost:3000
CDN_URL=http://localhost:3000
APP_ENV=local                      # required: local | test | staging | production (local/test need a localhost APP_URL)

# Database (Postgres with PostGIS)
# One role per job (P0-20, DECISIONS): the app refuses to start on the owner or a superuser. Locally
# `pnpm db:migrate` gives moz_app / moz_auth / moz_worker LOGIN with the passwords below (local Docker only).
DATABASE_URL=postgres://moz_app:moz_app@localhost:5432/moz                # web + tenant jobs (moz_app, under RLS)
DATABASE_URL_AUTH=postgres://moz_auth:moz_auth@localhost:5432/moz         # Better Auth + identity lookups (moz_auth)
DATABASE_URL_WORKER=postgres://moz_worker:moz_worker@localhost:5432/moz   # worker/CLI cross-shop sweeps (BYPASSRLS); never on the web
DATABASE_URL_MIGRATIONS=postgres://moz:moz@localhost:5432/moz             # owner: migrations only (direct, non-pooled, DDL rights)
DATABASE_URL_TEST=postgres://moz:moz@localhost:5432/moz_test              # integration/E2E test databases (owner URL; local/CI only)

# Redis
REDIS_URL=redis://:moz@localhost:6379                               # redis-queue (noeviction: BullMQ, limits). staging/production: rediss:// (TLS) with a password
REDIS_KEY_PREFIX=                                                   # empty locally; required in staging/production (e.g. prod:)
REDIS_URL_TEST=redis://:moz@localhost:6379/1                       # integration tests (local/CI only)
REDIS_CACHE_URL=redis://:moz@localhost:6380                         # redis-cache (allkeys-lru): optional locally (defaults to this); staging/production: rediss://, another instance
REDIS_CACHE_URL_TEST=redis://:moz@localhost:6380/1                  # integration tests (local/CI only)

# Auth
AUTH_SECRET=                       # 32+ random bytes, base64
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_IP_ALLOWLIST=                # optional, comma-separated
TRUSTED_PROXY=none                 # none (local/test) | caddy | cloudflare: which proxy header gives the client IP

# Encryption (field-level, AES-256-GCM) and blind index — required everywhere: base64 of exactly 32 bytes
# (`pnpm setup:env` generates them; elsewhere `openssl rand -base64 32`). BLIND_INDEX_KEY also derives the
# per-purpose keys for email and IP hashes (src/server/security/keys.ts).
DATA_ENCRYPTION_KEY=               # 32 bytes base64
DATA_ENCRYPTION_KEY_ID=k1
BLIND_INDEX_KEY=                   # 32 bytes base64
MEMBER_QR_SIGNING_KEY=             # 32 bytes base64

# Email
EMAIL_PROVIDER=smtp                # smtp (local/test → Mailpit only; refused on staging/production) | resend | brevo
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_API_URL=http://localhost:8025      # tests read emails through the Mailpit API
EMAIL_API_KEY=
EMAIL_FALLBACK_PROVIDER=                  # staging/production: required, different from EMAIL_PROVIDER (brevo when primary is resend)
EMAIL_FALLBACK_API_KEY=
LIVE_TEST_EMAIL_TO=                       # test inbox for `pnpm test:live` (staging only; never a real customer)
EMAIL_FROM="Moz Rewards <hello@example.co.uk>"

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=              # public by design (browser subscribes with it)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.co.uk

# Storage (S3 API: MinIO locally/tests, Cloudflare R2 on staging/production)
S3_ENDPOINT=http://localhost:9000          # R2: https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=moz
S3_SECRET_ACCESS_KEY=moz-minio-local
S3_BUCKET=moz-rewards
S3_FORCE_PATH_STYLE=true                   # true for MinIO, false for R2
S3_PUBLIC_BASE_URL=                        # public CDN base (cdn.<domain>) on staging/production

# Bot protection (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=            # public by design (rendered in the browser widget)
TURNSTILE_SECRET_KEY=                       # required on staging/production (boot refuses without it)

# AI review help
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=

# Google (optional features)
GOOGLE_PLACES_API_KEY=
GOOGLE_BUSINESS_PROFILE_ENABLED=false

# Demo seed (P0-16)
DEMO_EMAIL_BASE=                   # staging only: one real inbox you control (no + part); demo accounts become inbox+moz-<role>@… (local: Mailpit default)

# Observability (P0-13)
ALERT_EMAILS=                      # both developers, comma-separated; required on staging/production (local: Mailpit default)
EMAIL_DAILY_CAP=400                # combined provider cap per UK day (Resend 100 + Brevo 300); 70% alert
HEALTH_TOKEN=                      # optional, 32+ chars: /api/health/ready shows per-check detail only with Authorization: Bearer <token>
DISK_PATH=/                        # filesystem watched for the 80% disk alert (the data volume on the VPS)
BACKUPS_ENABLED=false              # true once the backup jobs run (P0-15): alerts on dump/WAL/drill age
SENTRY_DSN=                        # server + worker; the browser uses a placeholder and the /api/monitoring tunnel (H-34)
APP_RELEASE=                       # git SHA (Sentry release tag), set by the deploy (P0-15)
SENTRY_ERROR_SAMPLE_RATE=1         # 0–1 share of error events sent (plus a per-process cap of 30 per 10 min)
SENTRY_BROWSER_DAILY_CAP=60        # browser errors forwarded by the /api/monitoring tunnel per UK day
SENTRY_MONTHLY_QUOTA=5000          # Sentry free plan errors/month; 70% alert from our own sent counter
NEXT_PUBLIC_SENTRY_ENABLED=false   # load the browser SDK (lazily, after hydration); true on staging/production
NEXT_PUBLIC_UMAMI_PATH=            # Umami, same origin under this path (e.g. /u; Caddy proxies it, P0-15); unset = no analytics, no notice
NEXT_PUBLIC_UMAMI_WEBSITE_ID=      # Umami website id (uuid); loaded only after the visitor allows analytics

# Logging
LOG_LEVEL=info                     # trace | debug | info | warn | error

# E2E (optional: run Playwright against a deployed env instead of localhost)
# E2E_BASE_URL=https://staging.example.co.uk

# Staging protection
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASSWORD=
