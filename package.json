{
  "name": "moz-rewards",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --import ./scripts/server-only-hook.mjs src/worker/index.ts",
    "relay": "tsx --import ./scripts/server-only-hook.mjs scripts/relay.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint --max-warnings=0 && tsx scripts/check-css-hex.ts && tsx scripts/check-migrations.ts && tsx scripts/check-authz-coverage.ts",
    "format": "prettier --write .",
    "fix": "(eslint --fix --max-warnings=0 . || echo [fix] eslint: errors remain) && prettier --write --log-level warn .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "tsx scripts/e2e.ts",
    "e2e:dev": "tsx scripts/e2e.ts --dev",
    "e2e:visual": "tsx scripts/e2e.ts --visual",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:unit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:rls-bench": "tsx scripts/rls-bench.ts",
    "db:migrate:test": "tsx src/server/db/migrate.ts --test",
    "db:seed": "tsx --conditions=react-server src/server/db/seed.ts",
    "db:reset": "tsx src/server/db/reset.ts && pnpm db:seed",
    "demo:credentials": "tsx --conditions=react-server scripts/demo-credentials.ts",
    "db:studio": "drizzle-kit studio",
    "setup:env": "tsx scripts/setup-env.ts",
    "services:up": "tsx scripts/services.ts up",
    "services:down": "tsx scripts/services.ts down",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "gate:task": "tsx scripts/gate-task.ts",
    "gate:phase": "tsx scripts/gate-phase.ts",
    "ci:usage": "tsx scripts/ci-usage.ts",
    "test:mutation": "stryker run",
    "test:load:smoke": "tsx scripts/load-smoke.ts",
    "test:live": "vitest run --config vitest.live.config.mts",
    "test:titles": "tsx scripts/check-test-titles.ts",
    "clear:check": "tsx scripts/check-clear.ts",
    "check:full": "pnpm typecheck && pnpm lint && pnpm test",
    "check:bundle": "tsx scripts/check-client-bundle.ts",
    "sast": "tsx scripts/sast.ts",
    "osv:gate": "tsx scripts/osv-gate.ts",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@better-auth/passkey": "^1.7.18",
    "@node-rs/argon2": "^2.2.2",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.1",
    "@sentry/browser": "11.11.0",
    "@sentry/node": "11.11.0",
    "better-auth": "^1.7.18",
    "bullmq": "6.4.2",
    "drizzle-orm": "^0.45.4",
    "ioredis": "6.0.0",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "nodemailer": "^10.3.1",
    "pino": "^10.4.0",
    "postgres": "^4.1.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "auth": "1.7.18",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.0",
    "lefthook": "^2.2.2",
    "otpauth": "^9.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "24.x"
  }
}
